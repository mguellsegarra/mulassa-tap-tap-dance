{
  "appId": "cat.mulassa.games",
  "appName": "Mulassa Games",
  "webDir": "dist",
  "server": {
    "appStartPath": "/jocs/index.html",
    "hostname": "app.mulassa.cat"
  },
  "ios": {
    "contentInset": "never"
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "CapacitorUpdater": {
      "autoUpdate": false,
      "appReadyTimeout": 10000,
      "statsUrl": "",
      "updateUrl": "",
      "channelUrl": ""
    },
    "SplashScreen": {
      "launchAutoHide": false,
      "launchFadeOutDuration": 300,
      "backgroundColor": "#2a1a10",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP",
      "splashFullScreen": true,
      "splashImmersive": true
    }
  },
  "backgroundColor": "#2a1a10"
}
