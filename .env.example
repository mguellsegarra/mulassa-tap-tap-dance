# Public client configuration. Never put an admin/service-role key in VITE_*.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Enable only after remote auth/CAPTCHA and privacy review are complete.
VITE_LEADERBOARD_PUBLISHING_ENABLED=false
VITE_LEADERBOARD_CAPTCHA_REQUIRED=true
VITE_TURNSTILE_SITE_KEY=
# Crash reports (Sentry, errors only; the DSN is public by design). Empty = no Sentry code runs, no requests.
VITE_SENTRY_DSN=

# Bústia de la plaça: the mulassa-feedback Worker (workers/feedback) URL, public; empty = no feedback button.
VITE_FEEDBACK_URL=
# true once the Worker can deliver (its TURNSTILE_SECRET_KEY and FEEDBACK_TO secrets set, the destination verified)
VITE_FEEDBACK_ENABLED=true
