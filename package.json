{
  "name": "mulassa-tap-tap-dance",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 5178",
    "build": "vite build",
    "capture": "node tools/qa/capture.mjs",
    "ui-review": "node tools/qa/ui-review.mjs",
    "audit:bou": "node tools/qa/bou-audit.mjs",
    "sweep:bou": "node tools/qa/bou-sweep.mjs",
    "build:pages": "npm run check:full && npm run build && node tools/deploy/seo-pages.mjs && node tools/deploy/prepare-pages.mjs",
    "cf:login": "node tools/deploy/cloudflare.mjs login",
    "cf:whoami": "node tools/deploy/cloudflare.mjs whoami",
    "cf:projects": "node tools/deploy/cloudflare.mjs projects",
    "cf:deployments": "node tools/deploy/cloudflare.mjs deployments",
    "deploy:pages": "node tools/deploy/cloudflare.mjs deploy",
    "check": "node tests/run.mjs",
    "check:gpu": "node tests/run.mjs --gpu",
    "check:full": "node tests/run.mjs --full",
    "check:leaderboard": "node tests/run.mjs --group=leaderboard"
  },
  "dependencies": {
    "@sentry/browser": "^11.0.0",
    "@supabase/supabase-js": "^2.117.2",
    "planck": "^1.5.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "vite": "^7.1.0"
  }
}
