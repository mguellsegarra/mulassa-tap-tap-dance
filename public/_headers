/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # the game is not meant to be embedded (Turnstile's iframes are ours, not the other way round)
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  # https only for a year; no includeSubDomains (other subdomains of mulassa.cat are not ours to decide)
  Strict-Transport-Security: max-age=31536000

# the beta channel is for testers, not search engines (the page's canonical already points at mulassa.cat)
https://beta.mulassa.cat/*
  X-Robots-Tag: noindex

# Content-hashed, never change in place: Vite's /assets/*-<hash>.js|css, and the music (song.json asks for ?v=<hash>,
# tools/prepare-pages.mjs refuses unversioned audio URLs). A new build or mix gets a new URL.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/music/*
  Cache-Control: public, max-age=31536000, immutable

# The page itself always revalidates, so a deploy reaches everyone at once.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

/index.md
  Content-Type: text/markdown; charset=utf-8
/projecte/index.md
  Content-Type: text/markdown; charset=utf-8
/llms.txt
  Content-Type: text/plain; charset=utf-8
