<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/launcherBackground</item>
    </style>

    <!-- The launcher after the system splash: the game's dark brown, no action bar (it is all drawn by Compose). -->
    <style name="AppTheme.Launcher" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/launcherBackground</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!-- the web cover's brown and the Mulassa's rest pose, where the walking splash (launcher/Splash.kt) starts -->
        <item name="windowSplashScreenBackground">#140C07</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_rest</item>
        <item name="postSplashScreenTheme">@style/AppTheme.Launcher</item>
    </style>
</resources>